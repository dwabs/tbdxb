# Copy to .env.local and fill in from Supabase → Settings → API Keys.
# .env.local is gitignored — never commit real values.
#
# These are the *new* Supabase key format (sb_publishable_… / sb_secret_…),
# not the legacy anon/service_role JWTs. Both work; the new ones are what
# this project uses, so don't mix them.

NEXT_PUBLIC_SUPABASE_URL=
# Safe in the browser — Row Level Security is what guards the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses Row Level Security — never prefix with NEXT_PUBLIC_.
# Not needed until the admin-approval work.
SUPABASE_SECRET_KEY=
